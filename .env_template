POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackspain
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres-hackspain:5432/hackspain
SECRET_KEY=change-me-in-production
DEBUG=true

# L2 supervisor (Helmcode OpenAI-compatible API; pin a Cerebras-class model id)
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_API_KEY=
SUPERVISOR_MODEL=

# L4/L5 pager (HappyRobot outbound voice → Guli Moreno)
HAPPYROBOT_API_KEY=
HAPPYROBOT_WORKFLOW_ID=
ONCALL_PHONE=
ONCALL_NAME=Guli Moreno

# Containment scripts: none = local docker/iptables; aws = IAM/IGW/NACL
CLOUD=none
AGENT_BRIDGE=agentnet
AGENT_VPC_ID=
IGW_ID=
AGENT_NACL_ID=
