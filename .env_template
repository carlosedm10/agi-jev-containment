POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackspain
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres-hackspain:5432/hackspain
SECRET_KEY=change-me-in-production
DEBUG=true

# L2 supervisor (Helmcode OpenAI-compatible API; pin a Cerebras-class model id)
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_API_KEY=
SUPERVISOR_MODEL=

# L4/L5 pager (HappyRobot outbound voice). Destination is hardcoded on the
# outbound node — not in the JSON. Local trigger: scripts/page.sh (reads .env).
HAPPYROBOT_API_KEY=
HAPPYROBOT_WORKFLOW_ID=
HAPPYROBOT_HOOK_URL=
ONCALL_PHONE=
ONCALL_NAME=Guli Moreno

# Containment: none = this project (docker pause / close ports / cut agentnet / stop agents); aws = ideal (IAM / IGW / NACL)
CLOUD=none
AGENT_BRIDGE=agentnet
AGENT_VPC_ID=
IGW_ID=
AGENT_NACL_ID=
